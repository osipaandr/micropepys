# Copy values from this file into your local launch environment if needed.
# The frontend does not read `.env` directly at runtime.
# `MICROPEPYS_VOICE_FIXTURES_DIR` is optional because the app can request
# folder access interactively through the Manual Voice Testing panel.

MICROPEPYS_BACKEND_BASE_URL=http://127.0.0.1:8787
MICROPEPYS_VOICE_FIXTURES_DIR=/absolute/path/to/Micropepys/docs/voice-fixtures
